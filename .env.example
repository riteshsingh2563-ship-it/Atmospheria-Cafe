# ---------------------------------------------------------------------------
# Atmospheria – Firebase configuration
#
# Copy this file to `.env` (or `.env.local`) and paste the values from
#   Firebase Console → Project settings → Your apps → Web app → SDK config
#
# Every variable MUST be prefixed with VITE_ or Vite will not expose it.
#
# If VITE_FIREBASE_API_KEY is missing or empty the app automatically boots in
# DEMO MODE: a local (browser-storage backed) stand-in for Firestore / Auth /
# Storage so you can click through the whole site and the admin portal before
# a Firebase project exists. Nothing is sent anywhere in demo mode.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=atmospheria-raipur.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=atmospheria-raipur
VITE_FIREBASE_STORAGE_BUCKET=atmospheria-raipur.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Email of the first admin. `npm run seed` creates this Auth user + the
# matching admin_users/<uid> document that the security rules check.
VITE_SEED_ADMIN_EMAIL=owner@atmospheria.in
VITE_SEED_ADMIN_PASSWORD=change-me-please

# Public, non-secret venue details surfaced across the site
VITE_VENUE_PHONE=+919000000000
VITE_VENUE_INSTAGRAM=https://www.instagram.com/atmospheria.raipur
VITE_GOOGLE_MAPS_EMBED=https://www.google.com/maps?q=VIP+Road+Vishal+Nagar+Raipur&output=embed
