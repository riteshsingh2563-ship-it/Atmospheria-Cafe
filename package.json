{
  "name": "atmospheria-courtyard-kitchen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Atmospheria – The Courtyard Kitchen. Open-air multi-cuisine restaurant in Raipur. React + Tailwind + Firebase.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "smoke": "node scripts/smoke-test.mjs",
    "check:classes": "node scripts/check-classes.mjs",
    "test": "npm run check:classes && npm run smoke",
    "emulators": "firebase emulators:start",
    "deploy": "npm run build && firebase deploy",
    "deploy:rules": "firebase deploy --only firestore:rules,storage.rules",
    "seed": "node scripts/seed-firestore.mjs"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
